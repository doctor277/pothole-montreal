{
  "name": "pothole-mtl-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Project tooling for the Pothole MTL platform",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:mobile": "vitest run apps/mobile/src",
    "test:admin": "vitest run tests/unit",
    "test:db": "npx --no-install supabase test db --local",
    "lint:db": "npx --no-install supabase db lint --local --fail-on error"
  },
  "devDependencies": {
    "supabase": "^2.116.0",
    "vitest": "^4.1.11"
  }
}
